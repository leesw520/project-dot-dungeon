{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dot-dungeon-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "dot-dungeon-dev-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "dot-dungeon-play",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "play"
      ],
      "port": 5175
    },
    {
      "name": "dot-dungeon-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
